{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- assign gift_card_balance = gift_card.balance | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card_balance, shop: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'section-secondary.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="gift-card-page">
    <main class="page-width page-width--narrow text-center" style="padding: 3rem 0;">
      <div class="card contact-card">
        <h1>{{ shop.name }}</h1>
        <p class="text-muted">{{ 'gift_cards.issued.subtext' | t }}</p>
        <p class="gift-card-balance text-primary font-bold">{{ gift_card.balance | money }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="form-status form-status--error">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- endif -%}
        <p class="gift-card-code"><code>{{ gift_card.code | format_code }}</code></p>
        {%- if gift_card.pass_url -%}
          <p><a class="button button--primary" href="{{ gift_card.pass_url }}">{{ 'gift_cards.issued.shop_link' | t }}</a></p>
        {%- endif -%}
      </div>
    </main>
  </body>
</html>
