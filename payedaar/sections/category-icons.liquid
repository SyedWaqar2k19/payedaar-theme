<section
  class="section section-categories"
  data-section-id="{{ section.id }}"
  data-section-type="category-icons"
  data-reveal
>
  <div class="page-width">
    {% render 'section-header',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      accent: true
    %}

    {%- assign fallback_assets = 'category-home.jpg,category-kitchen.jpg,category-beauty.jpg,category-gadgets.jpg,category-fashion.jpg,category-deals.jpg' | split: ',' -%}
    <ul class="category-icons list-unstyled{% if section.settings.layout == 'tiles' %} category-icons--tiles{% endif %}" role="list" data-reveal-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_label = block.settings.label
          assign cat_link = block.settings.link
          if block.settings.collection != blank
            assign cat_collection = block.settings.collection
            if cat_label == blank
              assign cat_label = cat_collection.title
            endif
            if cat_link == blank
              assign cat_link = cat_collection.url
            endif
          endif
          if cat_link == blank
            assign cat_link = routes.collections_url
          endif
        -%}
        <li class="category-icons__item" {{ block.shopify_attributes }}>
          <a class="category-icons__link" href="{{ cat_link }}">
            <span class="category-icons__circle">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 150, 200',
                    sizes: '72px',
                    alt: cat_label,
                    class: 'category-icons__img'
                }}
              {%- elsif block.settings.collection != blank and block.settings.collection.featured_image != blank -%}
                {{
                  block.settings.collection.featured_image
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 150, 200',
                    sizes: '72px',
                    alt: cat_label,
                    class: 'category-icons__img'
                }}
              {%- elsif section.settings.layout == 'tiles' and forloop.index <= fallback_assets.size -%}
                <img
                  src="{{ fallback_assets[forloop.index0] | asset_url }}"
                  alt="{{ cat_label | escape }}"
                  class="category-icons__img"
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                {%- assign fallback_icon = block.settings.icon | default: 'grid' -%}
                <span class="category-icons__fallback" aria-hidden="true">
                  {% render 'icon', name: fallback_icon, size: 28 %}
                </span>
              {%- endif -%}
            </span>
            <span class="category-icons__label">{{ cat_label | default: 'Category' }}</span>
          </a>
        </li>
      {%- else -%}
        {%- assign placeholders = 'Home,Kitchen,Beauty,Gadgets,Fashion,Deals' | split: ',' -%}
        {%- for label in placeholders -%}
          <li class="category-icons__item">
            <a class="category-icons__link" href="{{ routes.collections_url }}">
              <span class="category-icons__circle">
                <span class="category-icons__fallback" aria-hidden="true">
                  {% render 'icon', name: 'grid', size: 28 %}
                </span>
              </span>
              <span class="category-icons__label">{{ label }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category icons",
  "tag": "section",
  "class": "section-category-icons",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find deals in every aisle"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "icons", "label": "Icon circles" },
        { "value": "tiles", "label": "Photo tiles" }
      ],
      "default": "tiles",
      "info": "Photo tiles look more premium when category images or collection images are set."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "options": [
            { "value": "grid", "label": "Grid" },
            { "value": "flame", "label": "Flame" },
            { "value": "home", "label": "Home" },
            { "value": "heart", "label": "Heart" },
            { "value": "cart", "label": "Cart" }
          ],
          "default": "grid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category icons",
      "blocks": [
        { "type": "category", "settings": { "label": "Home", "icon": "home" } },
        { "type": "category", "settings": { "label": "Kitchen", "icon": "grid" } },
        { "type": "category", "settings": { "label": "Beauty", "icon": "heart" } },
        { "type": "category", "settings": { "label": "Gadgets", "icon": "grid" } },
        { "type": "category", "settings": { "label": "Fashion", "icon": "heart" } },
        { "type": "category", "settings": { "label": "Hot Deals", "icon": "flame" } }
      ]
    }
  ]
}
{% endschema %}
