<section
  class="section section-categories"
  data-section-id="{{ section.id }}"
  data-section-type="category-icons"
  data-reveal
>
  <div class="page-width">
    {% render 'section-header',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      accent: true
    %}

    {%- assign fallback_assets = 'category-home.jpg,category-kitchen.jpg,category-beauty.jpg,category-gadgets.jpg,category-fashion.jpg,category-deals.jpg' | split: ',' -%}
    <ul class="category-icons list-unstyled{% if section.settings.layout == 'tiles' %} category-icons--tiles{% endif %}" role="list" data-reveal-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_label = block.settings.label
          assign cat_collection = block.settings.collection
          if cat_label == blank and cat_collection != blank
            assign cat_label = cat_collection.title
          endif
          if cat_collection == blank and cat_label != blank
            assign handle_guess = cat_label | handle
            assign label_down = cat_label | downcase
            if handle_guess == 'home-living' or handle_guess == 'home-and-living'
              assign handle_guess = 'home'
            elsif label_down contains 'best'
              assign handle_guess = 'best-sellers'
            elsif label_down contains 'hot' or label_down contains 'deal'
              assign handle_guess = 'hot-deals'
            endif
            assign cat_collection = collections[handle_guess]
          endif
          assign is_hot = false
          assign label_down = cat_label | downcase
          if cat_collection != blank
            if cat_collection.handle == 'hot-deals' or cat_collection.handle == 'hot-deal'
              assign is_hot = true
            endif
          endif
          if label_down contains 'hot' or label_down contains 'deal'
            assign is_hot = true
          endif
          if block.settings.icon == 'flame'
            assign is_hot = true
          endif
          assign tile_image = block.settings.image
          if tile_image == blank and cat_collection != blank and cat_collection.featured_image != blank
            assign tile_image = cat_collection.featured_image
          endif
          if section.settings.layout == 'tiles'
            assign img_width = 960
            assign img_widths = '320, 480, 640, 800, 960, 1200'
            assign img_sizes = '(min-width: 990px) 16vw, (min-width: 750px) 30vw, 42vw'
          else
            assign img_width = 240
            assign img_widths = '80, 120, 160, 240'
            assign img_sizes = '72px'
          endif
        -%}
        {%- capture cat_link -%}
          {%- render 'collection-url', target_collection: cat_collection, target_url: block.settings.link, target_label: cat_label -%}
        {%- endcapture -%}
        {%- assign cat_link = cat_link | strip -%}
        <li class="category-icons__item{% if is_hot %} category-icons__item--hot{% endif %}" {{ block.shopify_attributes }}>
          <a class="category-icons__link" href="{{ cat_link }}">
            <span class="category-icons__circle">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: img_width
                  | image_tag:
                    loading: 'lazy',
                    widths: img_widths,
                    sizes: img_sizes,
                    alt: cat_label,
                    class: 'category-icons__img'
                }}
              {%- elsif section.settings.layout == 'tiles' and forloop.index <= fallback_assets.size -%}
                <img
                  src="{{ fallback_assets[forloop.index0] | asset_url }}"
                  alt="{{ cat_label | escape }}"
                  class="category-icons__img"
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                {%- assign fallback_icon = block.settings.icon | default: 'grid' -%}
                <span class="category-icons__fallback" aria-hidden="true">
                  {% render 'icon', name: fallback_icon, size: 28 %}
                </span>
              {%- endif -%}
            </span>
            {%- if is_hot -%}
              <span class="category-icons__hot-badge">
                {% render 'icon', name: 'flame', size: 12 %}
                {{ 'general.hot_badge' | t }}
              </span>
            {%- endif -%}
            <span class="category-icons__label">{{ cat_label | default: 'Category' }}</span>
          </a>
        </li>
      {%- else -%}
        {%- assign placeholders = 'Deals,Home,Kitchen,Beauty,Gadgets,Fashion' | split: ',' -%}
        {%- for label in placeholders -%}
          {%- capture cat_link -%}
            {%- render 'collection-url', target_label: label -%}
          {%- endcapture -%}
          <li class="category-icons__item{% if label == 'Deals' %} category-icons__item--hot{% endif %}">
            <a class="category-icons__link" href="{{ cat_link | strip }}">
              <span class="category-icons__circle">
                <span class="category-icons__fallback" aria-hidden="true">
                  {% render 'icon', name: 'grid', size: 28 %}
                </span>
              </span>
              {%- if label == 'Deals' -%}
                <span class="category-icons__hot-badge">
                  {% render 'icon', name: 'flame', size: 12 %}
                  {{ 'general.hot_badge' | t }}
                </span>
              {%- endif -%}
              <span class="category-icons__label">{{ label }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category icons",
  "tag": "section",
  "class": "section-category-icons",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find deals in every aisle"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "icons", "label": "Icon circles" },
        { "value": "tiles", "label": "Photo tiles" }
      ],
      "default": "tiles",
      "info": "Photo tiles look more premium when category images or collection images are set."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "options": [
            { "value": "grid", "label": "Grid" },
            { "value": "flame", "label": "Flame" },
            { "value": "home", "label": "Home" },
            { "value": "heart", "label": "Heart" },
            { "value": "cart", "label": "Cart" }
          ],
          "default": "grid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category icons",
      "blocks": [
        { "type": "category", "settings": { "label": "Hot Deals", "icon": "flame", "collection": "hot-deals" } },
        { "type": "category", "settings": { "label": "Home", "icon": "home", "collection": "home" } },
        { "type": "category", "settings": { "label": "Kitchen", "icon": "grid", "collection": "kitchen" } },
        { "type": "category", "settings": { "label": "Beauty", "icon": "heart", "collection": "beauty" } },
        { "type": "category", "settings": { "label": "Gadgets", "icon": "grid", "collection": "gadgets" } },
        { "type": "category", "settings": { "label": "Fashion", "icon": "heart", "collection": "fashion" } }
      ]
    }
  ]
}
{% endschema %}
