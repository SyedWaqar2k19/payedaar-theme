<section
  class="section section-deal-rails"
  data-section-id="{{ section.id }}"
  data-section-type="deal-rails"
  data-reveal
>
  <div class="page-width">
    <header class="section-header section-header--row">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__heading section-header__heading--accent">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </header>

    <div class="deal-rails" data-reveal-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_link = block.settings.link
          if block.settings.collection != blank and card_link == blank
            assign card_link = block.settings.collection.url
          endif
          if card_link == blank
            assign card_link = routes.collections_url
          endif
        -%}
        <a
          class="deal-rail-card deal-rail-card--{{ block.settings.tone | default: 'orange' }}"
          href="{{ card_link }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 900',
                sizes: '(min-width: 990px) 25vw, 50vw',
                class: 'deal-rail-card__img',
                alt: block.settings.heading
            }}
          {%- else -%}
            <span class="deal-rail-card__wash" aria-hidden="true"></span>
          {%- endif -%}
          <span class="deal-rail-card__body">
            {%- if block.settings.eyebrow != blank -%}
              <span class="deal-rail-card__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <span class="deal-rail-card__heading">{{ block.settings.heading }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="deal-rail-card__text">{{ block.settings.text }}</span>
            {%- endif -%}
            <span class="deal-rail-card__cta">
              {{ block.settings.button_label | default: 'Shop now' }}
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Deal rails",
  "tag": "section",
  "class": "section-deal-rails",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated picks for every room — COD friendly"
    }
  ],
  "blocks": [
    {
      "type": "rail",
      "name": "Deal rail",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Budget"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Under Rs. 999"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Everyday essentials"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "CTA",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Color tone",
          "options": [
            { "value": "orange", "label": "Orange" },
            { "value": "teal", "label": "Teal" },
            { "value": "amber", "label": "Amber" },
            { "value": "rose", "label": "Rose" }
          ],
          "default": "orange"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Deal rails",
      "blocks": [
        {
          "type": "rail",
          "settings": {
            "eyebrow": "Budget",
            "heading": "Under Rs. 999",
            "text": "Everyday essentials",
            "tone": "orange"
          }
        },
        {
          "type": "rail",
          "settings": {
            "eyebrow": "Kitchen",
            "heading": "Cook smarter",
            "text": "Tools & gadgets",
            "tone": "teal"
          }
        },
        {
          "type": "rail",
          "settings": {
            "eyebrow": "Beauty",
            "heading": "Glow deals",
            "text": "Self-care picks",
            "tone": "rose"
          }
        },
        {
          "type": "rail",
          "settings": {
            "eyebrow": "Gadgets",
            "heading": "Tech drops",
            "text": "New & trending",
            "tone": "amber"
          }
        }
      ]
    }
  ]
}
{% endschema %}
