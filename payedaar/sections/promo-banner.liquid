<section
  class="section section-promo"
  data-section-id="{{ section.id }}"
  data-section-type="promo-banner"
  data-reveal
>
  <div class="page-width">
    {% render 'section-header',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      accent: true
    %}

    <div class="promo-banner{% if section.blocks.size == 1 %} promo-banner--single{% elsif section.blocks.size == 2 %} promo-banner--two{% else %} promo-banner--three{% endif %}" data-reveal-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign tone = block.settings.tone | default: 'orange'
          assign fallback_promo = 'promo-kitchen.jpg'
          if forloop.index == 2
            assign fallback_promo = 'promo-home.jpg'
          endif
        -%}
        {%- capture promo_link -%}
          {%- render 'collection-url', target_url: block.settings.link, target_label: block.settings.button_label -%}
        {%- endcapture -%}
        <a
          class="promo-banner__card promo-banner__card--{{ tone }}"
          href="{{ promo_link | strip }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 33vw, 100vw',
                class: 'promo-banner__img',
                alt: block.settings.heading
            }}
          {%- elsif forloop.index <= 2 -%}
            <img
              src="{{ fallback_promo | asset_url }}"
              class="promo-banner__img"
              width="1152"
              height="648"
              loading="lazy"
              decoding="async"
              alt=""
            >
          {%- else -%}
            <span class="promo-banner__placeholder promo-banner__placeholder--{{ tone }}" aria-hidden="true"></span>
          {%- endif -%}
          <span class="promo-banner__content">
            {%- if block.settings.eyebrow != blank -%}
              <span class="promo-banner__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <span class="promo-banner__heading">{{ block.settings.heading }}</span>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="promo-banner__cta">
                {{ block.settings.button_label }}
                {% render 'icon', name: 'arrow-right', size: 16 %}
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- else -%}
        <a class="promo-banner__card promo-banner__card--orange" href="{{ routes.collections_url }}">
          <span class="promo-banner__placeholder promo-banner__placeholder--orange" aria-hidden="true"></span>
          <span class="promo-banner__content">
            <span class="promo-banner__eyebrow">{{ 'sections.promo_banner.placeholder_eyebrow' | t }}</span>
            <span class="promo-banner__heading">{{ 'sections.promo_banner.placeholder_heading' | t }}</span>
            <span class="promo-banner__cta">{{ 'sections.promo_banner.shop_now' | t }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "class": "section-promo-banner",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Limited offer"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Under Rs. 999"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "CTA label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Placeholder tone",
          "options": [
            { "value": "orange", "label": "Orange" },
            { "value": "teal", "label": "Teal" },
            { "value": "rose", "label": "Rose" },
            { "value": "amber", "label": "Amber" },
            { "value": "ink", "label": "Ink" }
          ],
          "default": "orange"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banner",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "eyebrow": "Budget picks",
            "heading": "Under Rs. 999",
            "button_label": "Shop now",
            "tone": "orange"
          }
        },
        {
          "type": "banner",
          "settings": {
            "eyebrow": "Fresh drops",
            "heading": "New arrivals",
            "button_label": "Explore",
            "tone": "teal"
          }
        }
      ]
    }
  ]
}
{% endschema %}
