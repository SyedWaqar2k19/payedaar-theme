<section class="section section-blog" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="page-header">
      <h1 class="page-header__title">{{ blog.title }}</h1>
    </header>

    <div class="grid grid--2 grid--3">
      {%- paginate blog.articles by section.settings.articles_per_page -%}
        {%- for article in blog.articles -%}
          <article class="card blog-card">
            {%- if article.image -%}
              <a class="blog-card__media" href="{{ article.url }}">
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 800',
                    sizes: '(min-width: 990px) 33vw, 50vw',
                    alt: article.title
                }}
              </a>
            {%- endif -%}
            <div class="card__body">
              <p class="text-muted blog-card__meta">{{ article.published_at | date: format: 'date' }}</p>
              <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              {%- if article.excerpt != blank -%}
                <div class="rte">{{ article.excerpt }}</div>
              {%- else -%}
                <p>{{ article.content | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <a class="section-header__link" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }}</a>
            </div>
          </article>
        {%- else -%}
          <p class="text-muted">{{ 'blogs.article.no_articles' | t }}</p>
        {%- endfor -%}

        <div style="grid-column: 1 / -1;">
          {% render 'pagination', paginate: paginate %}
        </div>
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 9
    }
  ]
}
{% endschema %}
