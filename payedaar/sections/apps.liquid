{%- if section.blocks.size > 0 -%}
  <div class="page-width section-apps__inner">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "class": "section-apps",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
