<section class="section section-customer" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="customer-card card">
      <h1 class="page-header__title">{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer', class: 'customer-form' -%}
        {{ form.errors | default_errors }}

        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input id="RegisterFirstName" class="input" type="text" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input id="RegisterLastName" class="input" type="text" name="customer[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input id="RegisterEmail" class="input" type="email" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input id="RegisterPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>

        <button type="submit" class="button button--primary button--full">
          {{ 'customer.register.submit' | t }}
        </button>
      {%- endform -%}

      <p class="customer-card__links">
        <a href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "section-main-register",
  "settings": []
}
{% endschema %}
