{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 8
  assign columns = section.settings.columns | default: 4
  assign grid_class = 'grid grid--2'
  if columns == 3
    assign grid_class = 'grid grid--3'
  elsif columns == 4
    assign grid_class = 'grid grid--4'
  endif
  assign has_products = false
  if collection != blank and collection.products_count > 0
    assign has_products = true
  endif
-%}

{%- if has_products or request.design_mode -%}
<section
  class="section section-featured-collection"
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection"
  data-reveal
>
  <div class="page-width">
    <div class="section-header section-header--row">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__heading section-header__heading--accent">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a class="section-header__link" href="{{ collection.url }}">
          {{ section.settings.view_all_label | default: 'View all' }}
          {% render 'icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      <div class="{{ grid_class }}" data-reveal-stagger>
        {%- for product in collection.products limit: products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="featured-collection-empty" role="status">
        <p class="featured-collection-empty__title">{{ 'sections.featured_collection.placeholder_title' | t }}</p>
        <p class="text-muted">{{ 'sections.featured_collection.placeholder_hint' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hot picks customers love right now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Section hides on the live storefront until a collection with products is selected."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
