<section class="section section-customer" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="customer-card card">
      <h1 class="page-header__title">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.activate_account.subtext' | t }}</p>
      {%- form 'activate_customer_password', class: 'customer-form' -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label class="field__label" for="password">{{ 'customer.activate_account.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="password" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label class="field__label" for="password_confirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input class="input" type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'customer.activate_account.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Activate account",
  "tag": "section",
  "class": "section-main-activate-account",
  "settings": []
}
{% endschema %}
