<section class="section section-customer" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="customer-card card">
      <h1 class="page-header__title">{{ 'customer.reset_password.title' | t }}</h1>
      {%- form 'reset_customer_password', class: 'customer-form' -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label class="field__label" for="password">{{ 'customer.reset_password.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="password" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label class="field__label" for="password_confirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input class="input" type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": []
}
{% endschema %}
