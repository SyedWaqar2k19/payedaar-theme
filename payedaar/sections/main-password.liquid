<section class="section section-password">
  <div class="password-page">
    <div class="password-page__panel">
      <div class="password-page__brand">
        {% render 'brand-logo',
          class: 'password-page__logo',
          width: 280,
          widths: '140, 200, 280',
          sizes: '180px',
          loading: 'eager',
          fetchpriority: 'high'
        %}
      </div>

      <h1 class="password-page__heading">{{ section.settings.heading | default: shop.name }}</h1>
      <p class="password-page__text">
        {%- if section.settings.message != blank -%}
          {{ section.settings.message }}
        {%- else -%}
          {{ 'general.password_message' | t }}
        {%- endif -%}
      </p>

      {% form 'storefront_password', class: 'password-form' %}
        {{ form.errors | default_errors }}
        <div class="field">
          <label class="visually-hidden" for="Password">{{ 'general.password' | t }}</label>
          <input
            id="Password"
            class="input input--pill"
            type="password"
            name="password"
            placeholder="{{ 'general.password' | t }}"
            autocomplete="current-password"
          >
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'general.submit' | t }}</button>
      {% endform %}

      <ul class="password-page__trust list-unstyled">
        <li>{{ settings.trust_delivery }}</li>
        {%- if settings.enable_cod_messaging -%}
          <li>{{ settings.trust_cod }}</li>
        {%- endif -%}
        <li>{{ settings.trust_returns }}</li>
      </ul>

      {%- if settings.whatsapp_number != blank -%}
        <a
          class="button button--secondary button--full mt-2"
          href="https://wa.me/{{ settings.whatsapp_number }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          {% render 'icon', name: 'whatsapp', size: 18 %}
          {{ 'general.whatsapp' | t }}
        </a>
      {%- endif -%}

      <p class="password-page__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Payedaar is almost ready"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "Enter the store password to preview deals, COD shopping, and nationwide delivery."
    }
  ]
}
{% endschema %}
