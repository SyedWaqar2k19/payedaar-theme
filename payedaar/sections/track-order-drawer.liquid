<track-order-drawer
  id="TrackOrderDrawer"
  class="track-drawer"
  data-track-drawer
  hidden
  aria-hidden="true"
>
  <div class="track-drawer__overlay" data-track-drawer-close tabindex="-1"></div>
  <div
    class="track-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="TrackDrawer-Title"
    tabindex="-1"
    data-track-drawer-panel
  >
    <div class="track-drawer__header">
      <h2 id="TrackDrawer-Title" class="track-drawer__title">{{ 'track_order.title' | t }}</h2>
      <button type="button" class="site-header__icon-btn" data-track-drawer-close>
        <span class="visually-hidden">{{ 'accessibility.close' | t | default: 'Close' }}</span>
        {% render 'icon', name: 'close', size: 22 %}
      </button>
    </div>

    <div class="track-drawer__body">
      <p class="track-drawer__lead">{{ 'track_order.drawer_instructions' | t }}</p>

      {%- assign wa_digits = settings.whatsapp_number | default: '' | strip -%}
      <form
        class="track-drawer__form"
        data-track-whatsapp-form
        data-wa-number="{{ wa_digits | escape }}"
        data-wa-title="{{ 'track_order.whatsapp_message_title' | t | escape }}"
      >
        <div class="field">
          <label class="field__label" for="TrackOrderNumber">{{ 'track_order.order_number' | t }}</label>
          <input
            id="TrackOrderNumber"
            class="input"
            type="text"
            name="order"
            autocomplete="off"
            placeholder="{{ 'track_order.order_placeholder' | t }}"
            data-track-order-number
          >
          <p class="track-drawer__field-hint">{{ 'track_order.order_optional_hint' | t }}</p>
        </div>
        <div class="field">
          <label class="field__label" for="TrackOrderPhone">{{ 'track_order.phone' | t }}</label>
          <input
            id="TrackOrderPhone"
            class="input"
            type="tel"
            name="phone"
            inputmode="tel"
            autocomplete="tel"
            placeholder="{{ 'track_order.phone_placeholder' | t }}"
            required
            data-track-phone
          >
        </div>
        <button
          type="submit"
          class="button button--primary button--full"
          {% if wa_digits == blank %}disabled aria-disabled="true"{% endif %}
        >
          {% render 'icon', name: 'whatsapp', size: 18 %}
          <span>{{ 'track_order.via_whatsapp' | t }}</span>
        </button>
        <button type="button" class="button button--secondary button--full" disabled aria-disabled="true">
          {{ 'track_order.online_soon' | t }}
        </button>
      </form>
    </div>
  </div>
</track-order-drawer>

{% schema %}
{
  "name": "Track order drawer",
  "settings": []
}
{% endschema %}
