<section class="section section-customer" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="page-header customer-account-header">
      <div>
        <h1 class="page-header__title">{{ 'customer.order.title' | t: name: order.name }}</h1>
        {%- assign order_date = order.created_at | date: format: 'date' -%}
        <p class="page-header__sub">{{ 'customer.order.date' | t: date: order_date }}</p>
      </div>
      <a class="button button--secondary button--sm" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a>
    </header>

    <div class="card contact-card mb-3">
      <div class="customer-table-wrap">
        <table class="customer-table">
          <thead>
            <tr>
              <th>{{ 'customer.order.product' | t }}</th>
              <th>{{ 'customer.order.sku' | t }}</th>
              <th>{{ 'customer.order.price' | t }}</th>
              <th>{{ 'customer.order.quantity' | t }}</th>
              <th>{{ 'customer.order.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for line_item in order.line_items -%}
              <tr>
                <td>
                  {{ line_item.title | link_to: line_item.product.url }}
                  {%- unless line_item.variant.title == 'Default Title' -%}
                    <br><span class="text-muted">{{ line_item.variant.title }}</span>
                  {%- endunless -%}
                </td>
                <td>{{ line_item.sku }}</td>
                <td>{{ line_item.final_price | money }}</td>
                <td>{{ line_item.quantity }}</td>
                <td>{{ line_item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <p class="mt-3 font-bold">
        {{ 'customer.order.total' | t }}: <span class="text-primary">{{ order.total_price | money }}</span>
      </p>
      <p class="text-muted">
        {{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }} ·
        {{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}
      </p>
      {%- for fulfillment in order.fulfillments -%}
        {%- if fulfillment.tracking_url != blank -%}
          <p class="mt-2">
            <a class="button button--secondary button--sm" href="{{ fulfillment.tracking_url }}" target="_blank" rel="noopener noreferrer">
              {% render 'icon', name: 'truck', size: 16 %}
              Track shipment{% if fulfillment.tracking_number != blank %} · {{ fulfillment.tracking_number }}{% endif %}
            </a>
          </p>
        {%- endif -%}
      {%- endfor -%}
      {%- if settings.whatsapp_number != blank -%}
        <p class="mt-2">
          <a
            class="button button--secondary button--sm"
            href="https://wa.me/{{ settings.whatsapp_number }}?text={{ 'Hi Payedaar, I need help with order ' | append: order.name | url_encode }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            {% render 'icon', name: 'whatsapp', size: 16 %}
            Order help
          </a>
        </p>
      {%- endif -%}
    </div>

    <div class="customer-account-grid">
      <div class="card contact-card">
        <h2 class="contact-card__heading">{{ 'customer.order.billing_address' | t }}</h2>
        {{ order.billing_address | format_address }}
      </div>
      <div class="card contact-card">
        <h2 class="contact-card__heading">{{ 'customer.order.shipping_address' | t }}</h2>
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order",
  "tag": "section",
  "class": "section-main-order",
  "settings": []
}
{% endschema %}
