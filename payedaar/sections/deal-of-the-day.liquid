{%- liquid
  assign end_raw = section.settings.end_datetime | strip
  assign products = section.settings.products
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign has_deal_products = false
  if products != blank and products.size > 0
    assign has_deal_products = true
  elsif collection != blank and collection.products_count > 0
    assign has_deal_products = true
  endif
-%}

{%- if has_deal_products or request.design_mode -%}
<section
  class="section section-deal-day"
  data-section-id="{{ section.id }}"
  data-section-type="deal-of-the-day"
  data-reveal
>
  <div class="page-width">
    <div class="deal-day">
      <div class="deal-day__intro">
        {% render 'section-header',
          heading: section.settings.heading,
          subheading: section.settings.subheading,
          accent: true
        %}

        {%- if section.settings.show_countdown and end_raw != blank -%}
          <deal-countdown
            class="deal-countdown"
            data-end="{{ end_raw | escape }}"
            data-ended-text="{{ 'sections.deal_of_the_day.ended' | t | escape }}"
          >
            <div class="deal-countdown__live" data-countdown-live>
              <div class="deal-countdown__unit">
                <span class="deal-countdown__value" data-days>00</span>
                <span class="deal-countdown__label">{{ 'sections.deal_of_the_day.days' | t }}</span>
              </div>
              <div class="deal-countdown__unit">
                <span class="deal-countdown__value" data-hours>00</span>
                <span class="deal-countdown__label">{{ 'sections.deal_of_the_day.hours' | t }}</span>
              </div>
              <div class="deal-countdown__unit">
                <span class="deal-countdown__value" data-minutes>00</span>
                <span class="deal-countdown__label">{{ 'sections.deal_of_the_day.minutes' | t }}</span>
              </div>
              <div class="deal-countdown__unit">
                <span class="deal-countdown__value" data-seconds>00</span>
                <span class="deal-countdown__label">{{ 'sections.deal_of_the_day.seconds' | t }}</span>
              </div>
            </div>
            <p class="deal-countdown__ended" data-countdown-ended hidden>
              {{ 'sections.deal_of_the_day.ended' | t }}
            </p>
          </deal-countdown>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="button button--primary mt-3"
            href="{{ section.settings.button_link | default: routes.collections_url }}"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="deal-day__products grid grid--2" data-reveal-stagger>
        {%- if products != blank and products.size > 0 -%}
          {%- for product in products limit: products_to_show -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- elsif collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: products_to_show -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- elsif request.design_mode -%}
          {%- for i in (1..2) -%}
            <article class="card product-card product-card--placeholder">
              <div class="card__media">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="card__body">
                <h3 class="card__title">{{ 'sections.deal_of_the_day.placeholder_title' | t }}</h3>
                <p class="text-muted">{{ 'sections.deal_of_the_day.placeholder_hint' | t }}</p>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Deal of the day",
  "tag": "section",
  "class": "section-deal-of-the-day",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Deal of the Day"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Grab it before the clock hits zero"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "End date & time",
      "info": "ISO format recommended, e.g. 2026-12-31T23:59:59+05:00",
      "default": "2026-12-31T23:59:59+05:00"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Or collection",
      "info": "Used when product list is empty"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop deals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Deal of the day"
    }
  ]
}
{% endschema %}
