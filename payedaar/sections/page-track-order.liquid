<section class="section section-track-order" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <header class="page-header page-header--center">
      <h1 class="page-header__title">{{ page.title | default: section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="page-header__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <div class="card contact-card mb-3 track-order-panel">
      <div class="rte">
        {%- if page.content != blank -%}
          {{ page.content }}
        {%- else -%}
          <p>{{ 'track_order.instructions' | t }}</p>
        {%- endif -%}
      </div>

      <form class="track-drawer__form mt-3" data-track-form>
        <div class="field">
          <label class="field__label" for="PageTrackOrderNumber">{{ 'track_order.order_number' | t }}</label>
          <input
            id="PageTrackOrderNumber"
            class="input"
            type="text"
            name="order"
            autocomplete="off"
            placeholder="{{ 'track_order.order_placeholder' | t }}"
            required
            data-track-order-number
          >
        </div>
        <div class="field">
          <label class="field__label" for="PageTrackOrderEmail">{{ 'track_order.email' | t }}</label>
          <input
            id="PageTrackOrderEmail"
            class="input"
            type="text"
            name="contact"
            autocomplete="email"
            placeholder="{{ 'track_order.email_placeholder' | t }}"
            required
            data-track-email
          >
        </div>
        <button type="submit" class="button button--primary button--full">
          {{ 'track_order.submit' | t }}
        </button>
        <p class="track-drawer__hint text-muted mt-2" data-track-hint hidden role="status"></p>
      </form>

      {%- if section.settings.tracking_url != blank -%}
        <p class="mt-3">
          <a class="button button--secondary button--full" href="{{ section.settings.tracking_url }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.tracking_label | default: 'Open tracking' }}
          </a>
        </p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endcase -%}
    {%- endfor -%}

    <div class="empty-state__actions" style="justify-content: center;">
      {%- if settings.whatsapp_number != blank -%}
        <a class="button button--secondary" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener noreferrer" data-track-whatsapp>
          {{ 'general.whatsapp' | t }}
        </a>
      {%- endif -%}
      <a class="button button--primary" href="{{ routes.account_url }}">{{ 'track_order.view_orders' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Track order",
  "tag": "section",
  "class": "section-track-order",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Track your order"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use your order number and email from the confirmation message"
    },
    {
      "type": "url",
      "id": "tracking_url",
      "label": "External tracking URL"
    },
    {
      "type": "text",
      "id": "tracking_label",
      "label": "Tracking button label",
      "default": "Track shipment"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
