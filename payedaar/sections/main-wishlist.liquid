<section class="section section-wishlist" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="page-header">
      <h1 class="page-header__title">{{ 'wishlist.title' | t }}</h1>
      <p class="page-header__sub">{{ 'wishlist.subtext' | t }}</p>
    </header>

    <div class="wishlist-grid grid grid--2 grid--4" data-wishlist-grid>
      <p class="text-muted" data-wishlist-empty>{{ 'wishlist.empty' | t }}</p>
    </div>

    <template data-wishlist-card-template>
      <article class="card product-card wishlist-card">
        <a class="card__media" data-wishlist-url>
          <img data-wishlist-image alt="" loading="lazy" width="400" height="400">
        </a>
        <div class="card__body">
          <h3 class="card__title"><a data-wishlist-url data-wishlist-title></a></h3>
          <p class="text-primary font-bold" data-wishlist-price></p>
          <button type="button" class="button button--secondary button--full" data-wishlist-remove>
            {{ 'wishlist.remove' | t }}
          </button>
        </div>
      </article>
    </template>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section-wishlist",
  "settings": []
}
{% endschema %}
