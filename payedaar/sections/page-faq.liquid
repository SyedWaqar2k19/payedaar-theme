<section class="section section-faq" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <header class="page-header page-header--center">
      <h1 class="page-header__title">{{ page.title | default: section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="page-header__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    {%- if page.content != blank -%}
      <div class="rte mb-3">{{ page.content }}</div>
    {%- endif -%}

    <div class="faq-list" data-faq-accordion>
      {%- for block in section.blocks -%}
        <details class="faq-item product-accordion" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary class="product-accordion__summary">{{ block.settings.question }}</summary>
          <div class="product-accordion__content rte">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- else -%}
        <details class="faq-item product-accordion" open>
          <summary class="product-accordion__summary">{{ 'faq.default_q1' | t }}</summary>
          <div class="product-accordion__content rte"><p>{{ 'faq.default_a1' | t }}</p></div>
        </details>
        <details class="faq-item product-accordion">
          <summary class="product-accordion__summary">{{ 'faq.default_q2' | t }}</summary>
          <div class="product-accordion__content rte"><p>{{ 'faq.default_a2' | t }}</p></div>
        </details>
        <details class="faq-item product-accordion">
          <summary class="product-accordion__summary">{{ 'faq.default_q3' | t }}</summary>
          <div class="product-accordion__content rte"><p>{{ 'faq.default_a3' | t }}</p></div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    {% render 'faq-json-ld', blocks: section.blocks %}
  {%- else -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": {{ 'faq.default_q1' | t | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ 'faq.default_a1' | t | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ 'faq.default_q2' | t | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ 'faq.default_a2' | t | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ 'faq.default_q3' | t | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ 'faq.default_a3' | t | json }}
          }
        }
      ]
    }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "COD, delivery, returns — answered simply"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you offer Cash on Delivery?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes — Cash on Delivery is available across Pakistan on eligible orders.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Do you offer Cash on Delivery?",
            "answer": "<p>Yes — Cash on Delivery is available across Pakistan on eligible orders.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Most orders arrive within a few business days depending on your city.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Easy returns within the stated window. See Shipping & Returns for full details.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
