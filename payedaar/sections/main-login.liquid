<section class="section section-customer" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="customer-card card">
      <h1 class="page-header__title">{{ 'customer.login.title' | t }}</h1>

      {%- form 'customer_login', class: 'customer-form' -%}
        {{ form.errors | default_errors }}

        <div class="field">
          <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input
            id="CustomerEmail"
            class="input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            required
            {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
          >
        </div>

        <div class="field">
          <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input
            id="CustomerPassword"
            class="input"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit" class="button button--primary button--full">
          {{ 'customer.login.submit' | t }}
        </button>
      {%- endform -%}

      <p class="customer-card__links">
        <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
        <a href="#recover" data-recover-toggle>{{ 'customer.login.forgot_password' | t }}</a>
      </p>
    </div>

    <div class="customer-card card mt-3" id="recover" hidden>
      <h2 class="contact-card__heading">{{ 'customer.recover_password.title' | t }}</h2>
      <p class="text-muted">{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password', class: 'customer-form' -%}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" role="status">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input id="RecoverEmail" class="input" type="email" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endform -%}
      <p class="customer-card__links"><a href="#login" data-recover-toggle>{{ 'customer.login.title' | t }}</a></p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-recover-toggle]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const recover = document.getElementById('recover');
      if (!recover) return;
      const show = recover.hasAttribute('hidden');
      recover.toggleAttribute('hidden', !show);
    });
  });
</script>

{% schema %}
{
  "name": "Login",
  "tag": "section",
  "class": "section-main-login",
  "settings": []
}
{% endschema %}
