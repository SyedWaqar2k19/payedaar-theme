{%- liquid
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
-%}

{%- if has_blocks or section.settings.text != blank -%}
  <div
    class="announcement-bar{% if has_blocks and section.blocks.size > 1 %} announcement-bar--rotating{% endif %}"
    role="region"
    aria-label="{{ 'sections.announcement_bar.label' | t }}"
    data-announcement-bar
    {% if section.settings.enable_dismiss %}data-dismissible{% endif %}
    {% if has_blocks and section.blocks.size > 1 %}
      data-announcement-rotate
      data-rotate-ms="{{ section.settings.rotate_seconds | default: 4 | times: 1000 }}"
    {% endif %}
  >
    <div class="page-width announcement-bar__inner">
      {%- if has_blocks -%}
        {%- for block in section.blocks -%}
          <div
            class="announcement-bar__msg{% if forloop.first %} is-active{% endif %}"
            data-announcement-msg
            {{ block.shopify_attributes }}
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
        {%- else -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if section.settings.enable_dismiss -%}
      <button
        type="button"
        class="announcement-bar__dismiss"
        data-announcement-dismiss
        aria-label="{{ 'accessibility.dismiss' | t }}"
      >
        {% render 'icon', name: 'close', size: 16 %}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement-bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Fallback text",
      "default": "Free delivery across Pakistan on orders over Rs. 2,999",
      "info": "Used when no message blocks are added"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Fallback link"
    },
    {
      "type": "range",
      "id": "rotate_seconds",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotate speed",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_dismiss",
      "label": "Allow dismiss",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cash on Delivery available on eligible orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
