{%- comment -%}
  Full-width 4-up trust strip under PDP gallery — distinct from buy-box pills.
{%- endcomment -%}

<div class="product-trust-strip" role="list">
  <div class="product-trust-strip__item" role="listitem">
    <span class="product-trust-strip__icon" aria-hidden="true">{% render 'icon', name: 'package', size: 22 %}</span>
    <div class="product-trust-strip__copy">
      <p class="product-trust-strip__title">{{ 'products.trust_strip.pack_title' | t }}</p>
      <p class="product-trust-strip__text">{{ 'products.trust_strip.pack_text' | t }}</p>
    </div>
  </div>
  <div class="product-trust-strip__item" role="listitem">
    <span class="product-trust-strip__icon" aria-hidden="true">{% render 'icon', name: 'home', size: 22 %}</span>
    <div class="product-trust-strip__copy">
      <p class="product-trust-strip__title">{{ 'products.trust_strip.nationwide_title' | t }}</p>
      <p class="product-trust-strip__text">{{ 'products.trust_strip.nationwide_text' | t }}</p>
    </div>
  </div>
  <div class="product-trust-strip__item" role="listitem">
    <span class="product-trust-strip__icon" aria-hidden="true">{% render 'icon', name: 'whatsapp', size: 22 %}</span>
    <div class="product-trust-strip__copy">
      <p class="product-trust-strip__title">{{ 'products.trust_strip.whatsapp_title' | t }}</p>
      <p class="product-trust-strip__text">{{ 'products.trust_strip.whatsapp_text' | t }}</p>
    </div>
  </div>
  <div class="product-trust-strip__item" role="listitem">
    <span class="product-trust-strip__icon" aria-hidden="true">{% render 'icon', name: 'zap', size: 22 %}</span>
    <div class="product-trust-strip__copy">
      <p class="product-trust-strip__title">{{ 'products.trust_strip.dispatch_title' | t }}</p>
      <p class="product-trust-strip__text">{{ 'products.trust_strip.dispatch_text' | t }}</p>
    </div>
  </div>
</div>
