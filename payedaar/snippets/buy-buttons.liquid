{%- comment -%}
  Buy box: qty + ATC + Buy Now + WhatsApp (side by side).
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_buy_now = true
  assign show_whatsapp = true
  if block.settings.show_buy_now == false
    assign show_buy_now = false
  endif
  if block.settings.show_whatsapp_inquiry == false
    assign show_whatsapp = false
  endif

  assign wa_raw = settings.whatsapp_number | default: '' | strip
  assign wa_digits = wa_raw | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''

  assign product_link = request.origin | append: product.url
  assign wa_message = 'products.whatsapp_inquiry' | t: title: product.title, url: product_link
  assign wa_text = wa_message | url_encode

  if wa_digits != blank
    assign wa_href = 'https://wa.me/' | append: wa_digits | append: '?text=' | append: wa_text
  else
    assign wa_href = 'https://api.whatsapp.com/send?text=' | append: wa_text
  endif
-%}

<div class="buy-buttons" {{ block.shopify_attributes }}>
  <product-form class="product-form" data-product-form>
    {%- form 'product', product, id: product_form_id, class: 'product-form__form', novalidate: 'novalidate' -%}
      {% render 'product-variant-picker',
        product: product,
        section_id: section_id,
        product_form_id: product_form_id
      %}

      <div class="buy-buttons__qty-row">
        <span class="buy-buttons__qty-label">{{ 'products.quantity_label' | t }}</span>
        <div class="qty-control buy-buttons__qty" data-product-qty>
          <button type="button" class="qty-control__btn" data-qty-minus aria-label="{{ 'cart.decrease' | t }}">
            {% render 'icon', name: 'minus', size: 16 %}
          </button>
          <input
            class="qty-control__input"
            type="number"
            name="quantity"
            id="Quantity-{{ section_id }}"
            value="1"
            min="1"
            {% if current_variant.inventory_management and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 %}
              max="{{ current_variant.inventory_quantity }}"
            {% endif %}
            data-qty-input
            aria-label="{{ 'cart.quantity' | t }}"
          >
          <button type="button" class="qty-control__btn" data-qty-plus aria-label="{{ 'cart.increase' | t }}">
            {% render 'icon', name: 'plus', size: 16 %}
          </button>
        </div>
      </div>

      <button
        type="submit"
        name="add"
        class="button button--primary button--lg buy-buttons__atc"
        data-add-to-cart
        data-main-atc
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span class="buy-buttons__atc-icon" aria-hidden="true">{% render 'icon', name: 'cart', size: 18 %}</span>
        <span data-add-to-cart-text>
          {%- if current_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </span>
        <span class="product-form__spinner" hidden aria-hidden="true"></span>
      </button>

      {%- if show_buy_now or show_whatsapp -%}
        <div class="buy-buttons__cta{% if show_buy_now and show_whatsapp %} buy-buttons__cta--split{% endif %}">
          {%- if show_buy_now -%}
            <button
              type="button"
              class="button button--lg buy-buttons__buy-now"
              data-buy-now
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span class="buy-buttons__buy-now-icon" aria-hidden="true">{% render 'icon', name: 'bolt', size: 16 %}</span>
              <span data-buy-now-text>{{ 'products.buy_now' | t }}</span>
            </button>
          {%- endif -%}

          {%- if show_whatsapp -%}
            <a
              class="button button--lg buy-buttons__whatsapp"
              href="{{ wa_href }}"
              target="_blank"
              rel="noopener noreferrer"
              data-product-whatsapp
            >
              <span class="buy-buttons__whatsapp-icon" aria-hidden="true">{% render 'icon', name: 'whatsapp', size: 18 %}</span>
              <span>{{ 'products.ask_whatsapp' | t }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_dynamic_checkout -%}
        <div class="buy-buttons__dynamic">
          {{ form | payment_button }}
        </div>
      {%- endif -%}
    {%- endform -%}
  </product-form>
</div>
