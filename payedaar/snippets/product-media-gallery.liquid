{%- comment -%}
  Media gallery — main viewer + thumbs; supports image + video.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
-%}

<media-gallery class="product-gallery" data-product-gallery>
  <div class="product-gallery__viewer" data-gallery-viewer>
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        {%- liquid
          assign is_active = false
          if featured and media.id == featured.id
            assign is_active = true
          elsif featured == blank and forloop.first
            assign is_active = true
          endif
        -%}
        <div
          class="product-gallery__slide{% if is_active %} is-active{% endif %}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          {% unless is_active %}hidden{% endunless %}
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <button
                type="button"
                class="product-gallery__zoom-trigger"
                data-gallery-zoom
                data-zoom-src="{{ media | image_url: width: 2000 }}"
                aria-label="{{ 'products.media.zoom' | t }}"
              >
                {%- if is_active -%}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'eager',
                      fetchpriority: 'high',
                      widths: '400, 600, 800, 1000, 1200, 1400',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      class: 'product-gallery__image',
                      alt: media.alt | default: product.title
                  }}
                {%- else -%}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200, 1400',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      class: 'product-gallery__image',
                      alt: media.alt | default: product.title
                  }}
                {%- endif -%}
              </button>
            {%- when 'external_video' -%}
              <div class="product-gallery__video">
                {{ media | external_video_tag: class: 'product-gallery__video-el' }}
              </div>
            {%- when 'video' -%}
              <div class="product-gallery__video">
                {{ media | video_tag: controls: true, class: 'product-gallery__video-el', image_size: '1100x' }}
              </div>
            {%- when 'model' -%}
              <div class="product-gallery__model">
                {{ media | model_viewer_tag }}
              </div>
            {%- else -%}
              {{
                media.preview_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  class: 'product-gallery__image',
                  alt: media.alt | default: product.title
              }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product-gallery__slide is-active" data-media-id="0">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-gallery__placeholder' }}
      </div>
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <ul class="product-gallery__thumbs list-unstyled" role="list" data-gallery-thumbs>
      {%- for media in product.media -%}
        {%- liquid
          assign is_active = false
          if featured and media.id == featured.id
            assign is_active = true
          elsif featured == blank and forloop.first
            assign is_active = true
          endif
        -%}
        <li>
          <button
            type="button"
            class="product-gallery__thumb{% if is_active %} is-active{% endif %}"
            data-thumb
            data-media-id="{{ media.id }}"
            aria-label="{{ 'products.media.thumbnail' | t: index: forloop.index }}"
            aria-current="{% if is_active %}true{% else %}false{% endif %}"
          >
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <span class="product-gallery__thumb-badge" aria-hidden="true">▶</span>
            {%- endif -%}
            {{
              media.preview_image
              | image_url: width: 160
              | image_tag:
                loading: 'lazy',
                widths: '80, 120, 160',
                sizes: '64px',
                alt: media.alt | default: product.title
            }}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <dialog class="product-gallery__lightbox" data-gallery-lightbox aria-label="{{ 'products.media.zoom' | t }}">
    <form method="dialog" class="product-gallery__lightbox-close">
      <button type="submit" class="site-header__icon-btn" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 22 %}
      </button>
    </form>
    <img class="product-gallery__lightbox-img" data-lightbox-img alt="" width="2000" height="2000">
  </dialog>
</media-gallery>
