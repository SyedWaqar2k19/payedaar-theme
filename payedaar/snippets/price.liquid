{%- comment -%}
  Price display — sale in primary orange, compare-at muted + struck.
  Usage: {% render 'price', product: product %}
         {% render 'price', product: product, use_variant: true %}
{%- endcomment -%}

{%- liquid
  if use_variant and product.selected_or_first_available_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at = target.compare_at_price
  assign price = target.price
  assign on_sale = false
  if compare_at != blank and compare_at > price
    assign on_sale = true
  endif
-%}

<div class="price{% if on_sale %} price--on-sale{% endif %}{% if target.available == false %} price--sold-out{% endif %}">
  <div class="price__regular">
    {%- if on_sale -%}
      {%- assign save_amount = compare_at | minus: price -%}
      {%- assign save_pct = save_amount | times: 100.0 | divided_by: compare_at | round -%}
      <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
      <span class="price__sale">{{ price | money }}</span>
      <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
      <s class="price__compare">{{ compare_at | money }}</s>
      {%- if show_badge -%}
        <span class="badge badge--sale" aria-label="{{ 'products.price.save_percent' | t: percent: save_pct }}">-{{ save_pct }}%</span>
      {%- endif -%}
      {%- if show_save_amount -%}
        {%- assign save_money = save_amount | money -%}
        <span class="price__save">{{ 'products.you_save' | t: amount: save_money }}</span>
      {%- endif -%}
    {%- else -%}
      <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
      <span class="price__current">{{ price | money }}</span>
    {%- endif -%}
  </div>
  {%- if target.unit_price_measurement -%}
    <div class="price__unit">
      {{ target.unit_price | money }} /
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{ target.unit_price_measurement.reference_value }}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </div>
  {%- endif -%}
</div>
