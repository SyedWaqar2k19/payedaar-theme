{%- comment -%}
  BreadcrumbList — visible nav + JSON-LD
  Usage: {% render 'breadcrumbs' %}
{%- endcomment -%}

{%- liquid
  assign show_crumbs = false
  assign crumb_2_name = blank
  assign crumb_2_path = blank
  assign crumb_3_name = blank
  assign crumb_3_path = blank

  case template.name
    when 'product'
      assign show_crumbs = true
      if collection
        assign crumb_2_name = collection.title | replace: '-', ' '
        if collection.handle == 'hot-deals' or collection.handle == 'hot-deal'
          assign crumb_2_name = 'general.hot_deals' | t
        endif
        assign crumb_2_path = collection.url
        assign crumb_3_name = product.title
        assign crumb_3_path = product.url
      else
        assign crumb_2_name = product.title
        assign crumb_2_path = product.url
      endif
    when 'collection'
      assign show_crumbs = true
      assign crumb_2_name = collection.title | replace: '-', ' '
      if collection.handle == 'hot-deals' or collection.handle == 'hot-deal'
        assign crumb_2_name = 'general.hot_deals' | t
      endif
      assign crumb_2_path = collection.url
    when 'list-collections'
      assign show_crumbs = true
      assign crumb_2_name = 'collections.list_title' | t
      assign crumb_2_path = routes.collections_url
    when 'blog'
      assign show_crumbs = true
      assign crumb_2_name = blog.title
      assign crumb_2_path = blog.url
    when 'article'
      assign show_crumbs = true
      assign crumb_2_name = blog.title
      assign crumb_2_path = blog.url
      assign crumb_3_name = article.title
      assign crumb_3_path = article.url
    when 'page'
      assign show_crumbs = true
      assign crumb_2_name = page.title
      assign crumb_2_path = page.url
  endcase
-%}

{%- if show_crumbs and crumb_2_name != blank -%}
  <nav class="breadcrumbs page-width" aria-label="{{ 'accessibility.breadcrumb' | t }}">
    <ol class="breadcrumbs__list list-unstyled">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      </li>
      {%- if crumb_3_name != blank -%}
        <li class="breadcrumbs__item">
          <a href="{{ crumb_2_path }}">{{ crumb_2_name }}</a>
        </li>
        <li class="breadcrumbs__item" aria-current="page">
          <span>{{ crumb_3_name }}</span>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item" aria-current="page">
          <span>{{ crumb_2_name }}</span>
        </li>
      {%- endif -%}
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.home' | t | json }},
        "item": {{ request.origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ crumb_2_name | json }},
        "item": {{ request.origin | append: crumb_2_path | json }}
      }
      {%- if crumb_3_name != blank -%}
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ crumb_3_name | json }},
        "item": {{ request.origin | append: crumb_3_path | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}
