{%- comment -%}
  Open Graph / Twitter / robots — Phase 8 SEO hardening
{%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | strip_html | truncate: 160
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif

  assign has_active_filters = false
  if request.page_type == 'collection' and collection.filters.size > 0
    for filter in collection.filters
      if filter.active_values.size > 0
        assign has_active_filters = true
      endif
      if filter.type == 'price_range'
        if filter.min_value.value != blank or filter.max_value.value != blank
          assign has_active_filters = true
        endif
      endif
    endfor
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_description != blank -%}
  <meta property="og:description" content="{{ og_description | escape }}">
  <meta name="description" content="{{ og_description | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' and product.featured_media -%}
  <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- elsif page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- if page_image.width -%}
    <meta property="og:image:width" content="{{ page_image.width }}">
  {%- endif -%}
  {%- if page_image.height -%}
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- endif -%}
{%- elsif settings.logo != blank -%}
  <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta name="twitter:description" content="{{ og_description | escape }}">
{%- endif -%}

{%- comment -%} Avoid thin duplicate indexation of filtered / tagged PLPs {%- endcomment -%}
{%- if request.page_type == 'collection' -%}
  {%- if has_active_filters or current_tags != blank -%}
    <meta name="robots" content="noindex,follow">
  {%- endif -%}
{%- endif -%}
